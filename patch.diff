+++ b/src/utils/junctions.ts
@@ -0,0 +1,208 @@
+import * as THREE from 'three';
+import type { WallMesh } from '../objects/WallMesh';
+
+export interface JunctionResult {
+  start: THREE.Vector3;
+  end: THREE.Vector3;
+  orientation: 'x' | 'z';
+}
+
+export function calculateWallJunctions(
+  rawStart: THREE.Vector3,
+  rawEnd: THREE.Vector3,
+  _newWallWidth: number,
+  existingWalls: Iterable<WallMesh>,
+): JunctionResult {
+  const dx = Math.abs(rawEnd.x - rawStart.x);
+  const dz = Math.abs(rawEnd.z - rawStart.z);
+  const orientation: 'x' | 'z' = dx >= dz ? 'x' : 'z';
+
+  const EPSILON = 0.05; // Distance threshold for clicking on/near wall
+
+  if (orientation === 'x') {
+    const wallZ = rawStart.z;
+    let startX = rawStart.x;
+    const endX = rawEnd.x;
+    const dirX = Math.sign(endX - startX);
+
+    if (dirX === 0) {
+      return {
+        start: new THREE.Vector3(startX, 0, wallZ),
+        end: new THREE.Vector3(endX, 0, wallZ),
+        orientation,
+      };
+    }
+
+    // 1. Adjust startX if clicking near existing wall face
+    for (const wall of existingWalls) {
+      if (wall.isPreview) continue;
+      const wallOrient = wall.getOrientation();
+
+      if (wallOrient === 'z') {
+        const wallX = wall.startPoint.x;
+        const halfW = wall.width / 2;
+        const leftFace = wallX - halfW;
+        const rightFace = wallX + halfW;
+        const minZ = Math.min(wall.startPoint.z, wall.endPoint.z) - halfW;
+        const maxZ = Math.max(wall.startPoint.z, wall.endPoint.z) + halfW;
+
+        if (wallZ >= minZ - EPSILON && wallZ <= maxZ + EPSILON) {
+          if (dirX > 0 && startX >= leftFace - EPSILON && startX <= rightFace + EPSILON) {
+            startX = rightFace;
+          } else if (dirX < 0 && startX >= leftFace - EPSILON && startX <= rightFace + EPSILON) {
+            startX = leftFace;
+          }
+        }
+      }
+    }
+
+    // 2. Trim endX if approaching existing walls
+    let closestEndX = endX;
+
+    for (const wall of existingWalls) {
+      if (wall.isPreview) continue;
+      const wallOrient = wall.getOrientation();
+
+      if (wallOrient === 'z') {
+        const wallX = wall.startPoint.x;
+        const halfW = wall.width / 2;
+        const leftFace = wallX - halfW;
+        const rightFace = wallX + halfW;
+        const minZ = Math.min(wall.startPoint.z, wall.endPoint.z) - halfW;
+        const maxZ = Math.max(wall.startPoint.z, wall.endPoint.z) + halfW;
+
+        if (wallZ >= minZ - EPSILON && wallZ <= maxZ + EPSILON) {
+          if (dirX > 0 && startX < leftFace) {
+            if (endX >= leftFace) {
+              if (leftFace < closestEndX) {
+                closestEndX = leftFace;
+              }
+            }
+          } else if (dirX < 0 && startX > rightFace) {
+            if (endX <= rightFace) {
+              if (rightFace > closestEndX) {
+                closestEndX = rightFace;
+              }
+            }
+          }
+        }
+      } else {
+        // Collinear X wall
+        const wZ = wall.startPoint.z;
+        if (Math.abs(wZ - wallZ) < EPSILON) {
+          const minX = Math.min(wall.startPoint.x, wall.endPoint.x);
+          const maxX = Math.max(wall.startPoint.x, wall.endPoint.x);
+
+          if (dirX > 0 && startX < minX && endX >= minX) {
+            if (minX < closestEndX) {
+              closestEndX = minX;
+            }
+          } else if (dirX < 0 && startX > maxX && endX <= maxX) {
+            if (maxX > closestEndX) {
+              closestEndX = maxX;
+            }
+          }
+        }
+      }
+    }
+
+    return {
+      start: new THREE.Vector3(startX, 0, wallZ),
+      end: new THREE.Vector3(closestEndX, 0, wallZ),
+      orientation,
+    };
+  } else {
+    // Z-aligned wall
+    const wallX = rawStart.x;
+    let startZ = rawStart.z;
+    const endZ = rawEnd.z;
+    const dirZ = Math.sign(endZ - startZ);
+
+    if (dirZ === 0) {
+      return {
+        start: new THREE.Vector3(wallX, 0, startZ),
+        end: new THREE.Vector3(wallX, 0, endZ),
+        orientation,
+      };
+    }
+
+    // 1. Adjust startZ if clicking near existing wall face
+    for (const wall of existingWalls) {
+      if (wall.isPreview) continue;
+      const wallOrient = wall.getOrientation();
+
+      if (wallOrient === 'x') {
+        const wallZ = wall.startPoint.z;
+        const halfW = wall.width / 2;
+        const bottomFace = wallZ - halfW;
+        const topFace = wallZ + halfW;
+        const minX = Math.min(wall.startPoint.x, wall.endPoint.x) - halfW;
+        const maxX = Math.max(wall.startPoint.x, wall.endPoint.x) + halfW;
+
+        if (wallX >= minX - EPSILON && wallX <= maxX + EPSILON) {
+          if (dirZ > 0 && startZ >= bottomFace - EPSILON && startZ <= topFace + EPSILON) {
+            startZ = topFace;
+          } else if (dirZ < 0 && startZ >= bottomFace - EPSILON && startZ <= topFace + EPSILON) {
+            startZ = bottomFace;
+          }
+        }
+      }
+    }
+
+    // 2. Trim endZ if approaching existing walls
+    let closestEndZ = endZ;
+
+    for (const wall of existingWalls) {
+      if (wall.isPreview) continue;
+      const wallOrient = wall.getOrientation();
+
+      if (wallOrient === 'x') {
+        const wallZ = wall.startPoint.z;
+        const halfW = wall.width / 2;
+        const bottomFace = wallZ - halfW;
+        const topFace = wallZ + halfW;
+        const minX = Math.min(wall.startPoint.x, wall.endPoint.x) - halfW;
+        const maxX = Math.max(wall.startPoint.x, wall.endPoint.x) + halfW;
+
+        if (wallX >= minX - EPSILON && wallX <= maxX + EPSILON) {
+          if (dirZ > 0 && startZ < bottomFace) {
+            if (endZ >= bottomFace) {
+              if (bottomFace < closestEndZ) {
+                closestEndZ = bottomFace;
+              }
+            }
+          } else if (dirZ < 0 && startZ > topFace) {
+            if (endZ <= topFace) {
+              if (topFace > closestEndZ) {
+                closestEndZ = topFace;
+              }
+            }
+          }
+        }
+      } else {
+        // Collinear Z wall
+        const wX = wall.startPoint.x;
+        if (Math.abs(wX - wallX) < EPSILON) {
+          const minZ = Math.min(wall.startPoint.z, wall.endPoint.z);
+          const maxZ = Math.max(wall.startPoint.z, wall.endPoint.z);
+
+          if (dirZ > 0 && startZ < minZ && endZ >= minZ) {
+            if (minZ < closestEndZ) {
+              closestEndZ = minZ;
+            }
+          } else if (dirZ < 0 && startZ > maxZ && endZ <= maxZ) {
+            if (maxZ > closestEndZ) {
+              closestEndZ = maxZ;
+            }
+          }
+        }
+      }
+    }
+
+    return {
+      start: new THREE.Vector3(wallX, 0, startZ),
+      end: new THREE.Vector3(wallX, 0, closestEndZ),
+      orientation,
+    };
+  }
+}
